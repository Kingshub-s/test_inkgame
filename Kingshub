local BlockedRemoteNames = {
    Logs = true,
    ActivateMultiplier = true,
}

pcall(function()
    local RS = ReplicatedStorage

    local gameFolder = nil
    for _, f in ipairs(RS:GetChildren()) do
        if f:IsA("Folder") and (f:FindFirstChild("Replication") or f:FindFirstChild("Remotes")) then
            gameFolder = f
            break
        end
    end
    if not gameFolder then
        gameFolder = RS:FindFirstChildOfClass("Folder")
    end
    if not gameFolder then return end

    local replication = gameFolder:FindFirstChild("Replication")
    local remotes = gameFolder:FindFirstChild("Remotes") or RS:FindFirstChild("Remotes")

    if replication then
        local logs = replication:FindFirstChild("Logs")
        if logs and logs:IsA("RemoteEvent") and BypassConfig.BlockLogs then
            local old = hookfunction(logs.FireServer, function(self, ...)
                if self == logs then return end
                return old(self, ...)
            end)
            table.insert(BlockedRemotes, "Logs")
        end

        local actMult = replication:FindFirstChild("ActivateMultiplier")
        if actMult and actMult:IsA("RemoteEvent") and BypassConfig.BlockActivateMultiplier then
            local old = hookfunction(actMult.FireServer, function(self, ...)
                if self == actMult then return end
                return old(self, ...)
            end)
            table.insert(BlockedRemotes, "ActivateMultiplier")
        end
    end

    if remotes then
        local rootCF = remotes:FindFirstChild("rootCFrame")
        if rootCF and rootCF:IsA("RemoteEvent") and BypassConfig.SpoofRootCFrame then
            local old = hookfunction(rootCF.FireServer, function(self, cf, ...)
                if self == rootCF then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and typeof(cf) == "CFrame" then
                        local dist = (hrp.Position - cf.Position).Magnitude
                        if dist > BypassConfig.MaxTeleportDistance then
                            return old(self, hrp.CFrame, ...)
                        end
                    end
                end
                return old(self, cf, ...)
            end)
            table.insert(BlockedRemotes, "rootCFrame [SPOOFED]")
        end

        local tpTo = remotes:FindFirstChild("TeleportTo")
        if tpTo and tpTo:IsA("RemoteEvent") and BypassConfig.BlockTeleportTo then
            local old = hookfunction(tpTo.FireServer, function(self, ...)
                if self == tpTo then return end
                return old(self, ...)
            end)
            table.insert(BlockedRemotes, "TeleportTo")
        end

        local secCam = remotes:FindFirstChild("SecurityCameraRemote")
        if secCam and secCam:IsA("RemoteEvent") and BypassConfig.BlockSecurityCamera then
            local old = hookfunction(secCam.FireServer, function(self, ...)
                if self == secCam then return end
                return old(self, ...)
            end)
            table.insert(BlockedRemotes, "SecurityCameraRemote")
        end

        local killRem = remotes:FindFirstChild("KillRemote")
        if killRem and (killRem:IsA("RemoteFunction") or killRem:IsA("RemoteEvent")) and BypassConfig.BlockKillRemote then
            if killRem:IsA("RemoteFunction") then
                local old = hookfunction(killRem.InvokeServer, function(self, ...)
                    if self == killRem then return nil end
                    return old(self, ...)
                end)
            else
                local old = hookfunction(killRem.FireServer, function(self, ...)
                    if self == killRem then return end
                    return old(self, ...)
                end)
            end
            table.insert(BlockedRemotes, "KillRemote")
        end
    end
end)

pcall(function()
    if not BypassConfig.UseNamecallHook then return end
    if not hookmetamethod or not getnamecallmethod then return end
    local oldNamecall
    local fn = function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            if typeof(self) == "Instance" and BlockedRemoteNames[self.Name] then
