                        tool:Activate()
                    end
                end
            end
        end
    end

    if Toggles.GuardAutoPower and Toggles.GuardAutoPower.Value then
        local selectedGuardPower = Options.SelectedGuardPower and Options.SelectedGuardPower.Value or "Ammo Drop"
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find(selectedGuardPower:lower()) then
                tool:Activate()
            end
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:lower():find(selectedGuardPower:lower()) then
                    tool.Parent = char
                    task.wait(0.1)
                    tool:Activate()
                end
            end
        end
    end
