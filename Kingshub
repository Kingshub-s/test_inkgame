local function refreshMinigameCache()
    if isHeavyPaused and isHeavyPaused() then return end
    if tick() - CacheTick < 10 then return end
    CacheTick = tick()
    MinigameCache = {}
    CurrentMinigame = detectCurrentMinigame()

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Part") then
            local name = obj.Name:lower()
            local data = {Obj = obj, Pos = obj.Position}

            if name:find("coin") then data.Type = "Coin"; table.insert(MinigameCache, data)
            elseif name:find("gem") then data.Type = "Gem"; table.insert(MinigameCache, data)
            elseif name:find("collectible") then data.Type = "Collectible"; table.insert(MinigameCache, data)
            elseif name:find("finish") or name:find("goal") or name:find("win") or name:find("endzone") then data.Type = "Win"; table.insert(MinigameCache, data)
            elseif name:find("dalgona") or name:find("cookie") then data.Type = "Dalgona"; table.insert(MinigameCache, data)
            elseif name:find("glass") or name:find("panel") then data.Type = "Glass"; table.insert(MinigameCache, data)
            elseif name:find("hide") or name:find("spot") or name:find("box") or name:find("locker") then data.Type = "Hide"; table.insert(MinigameCache, data)
            elseif name:find("rope") or name:find("jump") then data.Type = "Rope"; table.insert(MinigameCache, data)
            elseif name:find("redlight") or name:find("stop") or name:find("greenlight") then data.Type = "RedLight"; table.insert(MinigameCache, data)
            elseif name:find("tug") or name:find("war") then data.Type = "Tug"; table.insert(MinigameCache, data)
            elseif name:find("mingle") or name:find("door") then data.Type = "Mingle"; table.insert(MinigameCache, data)
            elseif name:find("drop") or name:find("pickup") or name:find("banana") or name:find("bandage") then data.Type = "Drop"; table.insert(MinigameCache, data)
            elseif name:find("barricade") or name:find("block") then data.Type = "Barricade"; table.insert(MinigameCache, data)
