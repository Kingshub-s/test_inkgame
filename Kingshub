            end
        end
        return oldNamecall(self, ...)
    end
    if newcclosure then
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(fn))
    else
        oldNamecall = hookmetamethod(game, "__namecall", fn)
    end
end)

