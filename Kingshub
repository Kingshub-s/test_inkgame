local MingleLastPos = nil
local MingleStuckTicks = 0
local MingleTargetNumber = nil

local function getMingleNumber()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local best = nil
    for _, gui in pairs(pg:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("TextButton") then
            local t = tostring(gui.Text or ""):gsub("%s", "")
            local n = tonumber(t)
            if n and n >= 1 and n <= 12 then
                local sz = 0
                pcall(function()
                    sz = (gui.AbsoluteSize and gui.AbsoluteSize.X or 0) * (gui.AbsoluteSize.Y or 0)
                end)
                if not best or sz > best.sz then
                    best = {n = n, sz = sz}
                end
            end
            local low = t:lower()
            local m = low:match("(%d+)")
            if m and (low:find("player") or low:find("need") or low:find("room")) then
                local nn = tonumber(m)
                if nn and nn >= 1 and nn <= 12 then
                    return nn
                end
            end
        end
    end
    return best and best.n or MingleTargetNumber
end

local function countPlayersNear(pos, radius)
    local c = 0
    for _, p in pairs(Players:GetPlayers()) do
        local r = getRoot(p)
        if r and (r.Position - pos).Magnitude <= radius then
            c = c + 1
        end
    end
    return c
end

local function mingleUnstuck(root, hum)
    if not root then return end
    local offset = Vector3.new(math.random(-10, 10), 8, math.random(-10, 10))
    pcall(function()
        root.Anchored = false
        if hum then
            hum.PlatformStand = false
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        root.CFrame = root.CFrame + offset
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    local char = LocalPlayer.Character
    if char then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
        task.delay(1.2, function()
            local c = LocalPlayer.Character
            if not c then return end
            for _, p in pairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    p.CanCollide = true
                end
            end
        end)
    end
end

local function findMingleRooms(root)
    local rooms = {}
    local candidates = {}
    refreshWSCache()
    for _, obj in pairs(WSCache.Parts) do
        if obj and obj.Parent then
            local n = obj.Name:lower()
            if n:find("door") or n:find("room") or n:find("mingle") or n:find("booth")
                or n:find("cabin") or n:find("closet") or n:find("entrance") then
                local pos = obj.Position
                if pos.Y > root.Position.Y - 15 then
                    local dist = (pos - root.Position).Magnitude
                    if dist < 150 then
                        table.insert(candidates, {Obj = obj, Pos = pos, Dist = dist})
                    end
                end
            end
        end
    end
    table.sort(candidates, function(a, b) return a.Dist < b.Dist end)
    -- Only count players for nearest rooms (cap 8)
    for i = 1, math.min(8, #candidates) do
        local c = candidates[i]
        c.Count = countPlayersNear(c.Pos, 12)
        table.insert(rooms, c)
    end
    return rooms
end

local _lastQTE = 0
local function doPowerHoldQTE()
    if tick() - _lastQTE < 0.11 then return end
    _lastQTE = tick()

    -- Official Mingle Power Hold keys (PC): R, G, F, Q, E
    local mingleKeys = {
        Enum.KeyCode.R, Enum.KeyCode.G, Enum.KeyCode.F,
        Enum.KeyCode.Q, Enum.KeyCode.E,
        Enum.KeyCode.Space,
    }

    -- First try to detect the exact key shown on screen
    local detectedKey = nil
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in pairs(pg:GetDescendants()) do
            if gui.Visible then
                local text = tostring(gui.Text or ""):upper():gsub("%s+", "")
                local name = (gui.Name or ""):upper()

                -- Look for single letter key prompts
                if #text == 1 and text:match("[RGFQE]") then
                    detectedKey = text
                elseif name:find("KEY") or name:find("QTE") or name:find("PROMPT") then
                    local letter = text:match("([RGFQE])")
                    if letter then detectedKey = letter end
                end

                -- Click any visible QTE / circle / prompt buttons
                if (gui:IsA("TextButton") or gui:IsA("ImageButton") or gui:IsA("Frame")) 
                    and gui.AbsoluteSize.X > 10 and gui.AbsoluteSize.Y > 10 then
                    local full = (name .. " " .. text):lower()
                    if full:find("qte") or full:find("key") or full:find("press")
                        or full:find("circle") or full:find("ring") or full:find("prompt")
                        or full:find("choke") or full:find("hold") or full:find("power") then
                        pcall(function()
                            if firesignal and gui.MouseButton1Click then
                                firesignal(gui.MouseButton1Click)
                            end
                            if gui.Activated then
                                pcall(function() firesignal(gui.Activated) end)
                            end
                        end)
                        pcall(function()
                            local pos = gui.AbsolutePosition
                            local sz = gui.AbsoluteSize
                            if mobileTap then
                                mobileTap(pos.X + sz.X / 2, pos.Y + sz.Y / 2)
                            end
                        end)
                    end
                end
            end
        end
    end

    -- Press detected key first, then spam the common ones
    if detectedKey then
        local keyCode = Enum.KeyCode[detectedKey]
        if keyCode then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
            end)
        end
    end

    for _, key in ipairs(mingleKeys) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end

    -- Console buttons fallback
    for _, key in ipairs({Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonB, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonY}) do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end)
    end

    pcall(function()
        if mouse1click then mouse1click() end
    end)
end

-- RINGTA-style: grab nearest player, QTE, TP them away from door
local _lastGrabTP = 0
local function mingleGrabChokeTP(root)
    if tick() - _lastGrabTP < 0.45 then return end
    _lastGrabTP = tick()

    local best, bestDist = nil, 18
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isEnemy(p) then
            local pr = getRoot(p)
            local ph = getHum(p)
            if pr and ph and ph.Health > 0 then
                local d = (pr.Position - root.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = pr
                end
            end
        end
    end
    if not best then return end

    -- Face + move close to victim
    local look = Vector3.new(best.Position.X, root.Position.Y, best.Position.Z)
    root.CFrame = CFrame.lookAt(root.Position, look)
    if bestDist > 4 then
        local toward = root.Position:Lerp(best.Position, 0.55)
        root.CFrame = CFrame.new(toward.X, root.Position.Y, toward.Z) * (root.CFrame - root.CFrame.Position)
    end

    -- Activate grab/choke tools
    local char = LocalPlayer.Character
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local n = tool.Name:lower()
                if n:find("grab") or n:find("choke") or n:find("power") or n:find("hold")
                    or n:find("hand") or n:find("kill") or n:find("attack") then
                    pcall(function() tool:Activate() end)
                else
                    pcall(function() tool:Activate() end)
                end
            end
        end
        -- Equip from backpack if needed
        local has = false
        for _, t in pairs(char:GetChildren()) do
            if t:IsA("Tool") then has = true break end
        end
        if not has then
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, tool in pairs(bp:GetChildren()) do
                    if tool:IsA("Tool") then
                        tool.Parent = char
                        pcall(function() tool:Activate() end)
                        break
                    end
                end
            end
        end
    end

    doPowerHoldQTE()

    -- Choke TP: push victim away from nearest door / center platform
    if Toggles.MingleChokeTP and Toggles.MingleChokeTP.Value then
        local doorPos = nil
        local rooms = findMingleRooms(root)
        if rooms and rooms[1] then
            doorPos = rooms[1].Pos
        end
        local away
        if doorPos then
            local dir = (best.Position - doorPos)
            if dir.Magnitude < 1 then dir = (best.Position - root.Position) end
            if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
            away = doorPos + dir.Unit * 45 + Vector3.new(0, 2, 0)
        else
            local dir = (best.Position - root.Position)
            if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
            away = best.Position + dir.Unit * 40 + Vector3.new(0, 2, 0)
        end

        -- Local player rides out (helps complete choke away from door)
        safeTeleport(root, CFrame.new(away), 180)

        -- Attempt client-side push on victim (works only with network ownership / during grab)
        pcall(function()
            best.CFrame = CFrame.new(away + Vector3.new(0, 0, 2))
            best.AssemblyLinearVelocity = (away - best.Position).Unit * 80
        end)
    end
end



local function enterMingleDoor(door, root)
    if not door or not door.Obj then return end
    local obj = door.Obj
    local targetCF = obj:IsA("Model") and obj:GetPivot() or obj.CFrame
    safeTeleport(root, targetCF + Vector3.new(0, 2, 0), 200)
    task.wait(0.08)
    local targets = {obj}
    for _, d in pairs(obj:GetDescendants()) do
        table.insert(targets, d)
    end
    for _, d in pairs(targets) do
        if d:IsA("ProximityPrompt") then
            pcall(function()
                local old = d.HoldDuration
                d.HoldDuration = 0
                fireproximityprompt(d)
                pcall(function() fireproximityprompt(d, 1, true) end)
                d.HoldDuration = old
            end)
        end
        if d:IsA("ClickDetector") then
            pcall(function() fireclickdetector(d) end)
        end
    end
    pressKey(Enum.KeyCode.E, 0.08)
    pressKey(Enum.KeyCode.ButtonX, 0.05)
    fireAllPromptsNear(root, 25)
    pcall(function()
        local cam = Workspace.CurrentCamera
