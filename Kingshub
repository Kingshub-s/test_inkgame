    pcall(function()
        if SpeedConn then SpeedConn:Disconnect() SpeedConn = nil end
        if NoClipConn then NoClipConn:Disconnect() NoClipConn = nil end
        if AntiRagdollConn then AntiRagdollConn:Disconnect() AntiRagdollConn = nil end
        if _stealthConn then _stealthConn:Disconnect() _stealthConn = nil end
        if MainLoopConn then MainLoopConn:Disconnect() MainLoopConn = nil end
        if LagBypass and LagBypass.Stop then LagBypass.Stop() end
    end)
    pcall(function()
        for _, c in pairs(RuntimeConnections or {}) do
            pcall(function() c:Disconnect() end)
        end
        if RuntimeConnections then table.clear(RuntimeConnections) end
    end)
    pcall(function()
        for p in pairs(ESPObjects or {}) do removeESP(p) end
        for _, obj in pairs(GlassESPObjects or {}) do
            if obj then pcall(function() obj:Remove() end) end
        end
        if GlassESPObjects then table.clear(GlassESPObjects) end
        if ESPObjects then table.clear(ESPObjects) end
    end)
    pcall(function()
        if Library and Library.Unload then Library:Unload() end
    end)
end

