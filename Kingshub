-- PLAYER HANDLERS


local function espWanted()
    if not Toggles then return false end
    return (Toggles.BoxESP and Toggles.BoxESP.Value)
        or (Toggles.NameESP and Toggles.NameESP.Value)
        or (Toggles.HealthESP and Toggles.HealthESP.Value)
        or (Toggles.DistanceESP and Toggles.DistanceESP.Value)
        or (Toggles.TracerESP and Toggles.TracerESP.Value)
        or (Toggles.GuardESP and Toggles.GuardESP.Value)
        or (Toggles.ESPHiders and Toggles.ESPHiders.Value)
        or (Toggles.ESPSeekers and Toggles.ESPSeekers.Value)
        or (Toggles.HS_ESPHiders and Toggles.HS_ESPHiders.Value)
        or (Toggles.HS_ESPSeekers and Toggles.HS_ESPSeekers.Value)
        or (Toggles.GlassBridgeESP and Toggles.GlassBridgeESP.Value)
end

addRuntimeConnection(Players.PlayerRemoving:Connect(function(p) removeESP(p) end))
addRuntimeConnection(Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer and espWanted() then
        createESP(p)
    end
end))

task.spawn(function()
    local wasOn = false
    while genv.KH_Runtime and genv.KH_Runtime.running do
        task.wait(1.5)
        local on = false
        pcall(function() on = espWanted and espWanted() end)
        if on and not wasOn then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then pcall(createESP, p) end
            end
        elseif not on and wasOn then
            for p in pairs(ESPObjects) do
                removeESP(p)
            end
        end
        wasOn = on
    end
end)



