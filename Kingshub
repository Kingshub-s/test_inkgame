-- Shared workspace scan cache (reduces GetDescendants spam)
local WSCache = { Parts = {}, Prompts = {}, Tick = 0 }
local function refreshWSCache(force)
    if not force and isHeavyPaused and isHeavyPaused() then return end
    if not force and tick() - WSCache.Tick < 8 then return end
    WSCache.Tick = tick()
    local parts, prompts = {}, {}
    local n = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        n = n + 1
        if n > 12000 then break end
        if obj:IsA("BasePart") then
            table.insert(parts, obj)
        elseif obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
            table.insert(prompts, obj)
        end
    end
    WSCache.Parts = parts
    WSCache.Prompts = prompts
end

local _lastPromptScan = 0
local function fireAllPromptsNear(root, range)
    range = range or 20
    if tick() - _lastPromptScan < 0.5 then return end
    _lastPromptScan = tick()
    refreshWSCache()
    for _, obj in pairs(WSCache.Prompts) do
        if obj and obj.Parent then
            if obj:IsA("ProximityPrompt") then
                local part = obj.Parent
                local pos = nil
                if part and part:IsA("BasePart") then pos = part.Position
                elseif part and part:IsA("Model") then pos = part:GetPivot().Position end
                if pos and (pos - root.Position).Magnitude <= range then
                    pcall(function()
                        local old = obj.HoldDuration
                        obj.HoldDuration = 0
                        fireproximityprompt(obj)
                        pcall(function() fireproximityprompt(obj, 1, true) end)
                        obj.HoldDuration = old
                    end)
                end
            elseif obj:IsA("ClickDetector") then
                local part = obj.Parent
                if part and part:IsA("BasePart") and (part.Position - root.Position).Magnitude <= range then
                    pcall(function() fireclickdetector(obj) end)
                    pcall(function() fireclickdetector(obj, 1) end)
                end
            end
        end
    end
end

local _lastKillAura = 0
local function killAura()
    if not Toggles.KillAura or not Toggles.KillAura.Value then return end
    if tick() - _lastKillAura < 0.4 then return end
    _lastKillAura = tick()

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local range = Options.KillAuraRange and Options.KillAuraRange.Value or 15
    local hit = false
    local targetRoot = nil

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isEnemy(player) then
            local pRoot = getRoot(player)
            local pHum = getHum(player)
            if pRoot and pHum and pHum.Health > 0 then
                local dist = (pRoot.Position - root.Position).Magnitude
                if dist <= range then
                    hit = true
                    targetRoot = pRoot
                    break
                end
            end
        end
    end

    if not hit or not targetRoot then return end

    -- Soft face (lerp) — hard CFrame snap is heavily flagged
    local look = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
    root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, look), 0.35)

    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() tool:Activate() end)
        end
    end

    local hasTool = false
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") then hasTool = true break end
    end
    if not hasTool then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            for _, tool in pairs(bp:GetChildren()) do
                if tool:IsA("Tool") then
                    tool.Parent = char
                    pcall(function() tool:Activate() end)
                    break
                end
            end
        end
    end

    if targetRoot.Parent then
        for _, obj in pairs(targetRoot.Parent:GetChildren()) do
            if obj:IsA("ClickDetector") then
                pcall(function() fireclickdetector(obj) end)
            elseif obj:IsA("ProximityPrompt") then
                pcall(function()
                    local old = obj.HoldDuration
                    obj.HoldDuration = 0
                    fireproximityprompt(obj)
                    obj.HoldDuration = old
                end)
            end
        end
    end

    task.spawn(spamAttackKeys)
end

local function findObject(namePatterns, parent, classFilter)
    parent = parent or Workspace
    classFilter = classFilter or "BasePart"
    for _, obj in pairs(parent:GetDescendants()) do
        if obj:IsA(classFilter) then
            local name = obj.Name:lower()
            for _, pattern in pairs(namePatterns) do
                if name:find(pattern:lower()) then
                    return obj
                end
            end
        end
    end
    return nil
end


