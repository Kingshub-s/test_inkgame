-- Physics Bypass
local PhysicsBypass = {}

function PhysicsBypass.SetupFly(root)
    if not root then return nil, nil, nil end
    for _, c in pairs(root:GetChildren()) do
        if c:IsA("BodyVelocity") or c:IsA("BodyGyro") then
            pcall(function() c:Destroy() end)
        end
    end

    local att = root:FindFirstChild("KH_StealthAttach")
    if not att then
        att = Instance.new("Attachment")
        att.Name = "KH_StealthAttach"
        att.Position = Vector3.new(0, 0, 0)
        att.Parent = root
    end

    local lv = root:FindFirstChild("KH_StealthLV")
    if not lv then
        lv = Instance.new("LinearVelocity")
        lv.Name = "KH_StealthLV"
        lv.Attachment0 = att
        lv.MaxForce = math.huge
        lv.VectorVelocity = Vector3.new(0, 0, 0)
        lv.Parent = root
    end

    local ao = root:FindFirstChild("KH_StealthAO")
    if not ao then
        ao = Instance.new("AlignOrientation")
        ao.Name = "KH_StealthAO"
        ao.Attachment0 = att
        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ao.MaxTorque = math.huge
        ao.Parent = root
    end

    return lv, ao, att
end

function PhysicsBypass.CleanupFly(root)
    if not root then return end
    for _, n in ipairs({"KH_StealthAttach", "KH_StealthLV", "KH_StealthAO"}) do
        local c = root:FindFirstChild(n)
        if c then pcall(function() c:Destroy() end) end
    end
end

-- Anti-LagCounteract
local LagBypass = {}
local LagConnections = {}
local CharLagConnections = {}

local function clearCharLagConnections()
    for _, c in ipairs(CharLagConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(CharLagConnections)
end

function LagBypass.CleanCharacter(char)
    if not char then return end
    for _, name in ipairs({"Ragdoll", "StopLerpTrue", "Fly", "FakeHRP"}) do
        local obj = char:FindFirstChild(name)
        if obj then
            pcall(function() obj:Destroy() end)
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Anchored then
        hrp.Anchored = false
    end
    pcall(function()
        char:SetAttribute("CurrentlyInTestTP", nil)
        char:SetAttribute("JustForceUpdated", nil)
        char:SetAttribute("ForcedPosition", nil)
        char:SetAttribute("StunsBlockTracking", nil)
        char:SetAttribute("LoadingLagCounteractClient", nil)
    end)
end

function LagBypass.Start()
    if LocalPlayer.Character then
        LagBypass.CleanCharacter(LocalPlayer.Character)
    end

    table.insert(LagConnections, LocalPlayer.CharacterAdded:Connect(function(char)
        clearCharLagConnections()
        task.wait(0.5)
        LagBypass.CleanCharacter(char)

        table.insert(CharLagConnections, char.ChildAdded:Connect(function(child)
            if child.Name == "Ragdoll" or child.Name == "StopLerpTrue"
                or child.Name == "Fly" or child.Name == "FakeHRP" then
                task.defer(function()
                    pcall(function() child:Destroy() end)
                end)
            end
        end))

        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if hrp then
            table.insert(CharLagConnections, hrp:GetPropertyChangedSignal("Anchored"):Connect(function()
                if hrp.Anchored then
                    hrp.Anchored = false
                end
            end))
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            table.insert(CharLagConnections, hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
                if hum.PlatformStand then
                    hum.PlatformStand = false
                end
            end))
            table.insert(CharLagConnections, hum.StateChanged:Connect(function(_, new)
                if new == Enum.HumanoidStateType.Physics or new == Enum.HumanoidStateType.Ragdoll then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end))
        end
    end))
end

function LagBypass.Stop()
    clearCharLagConnections()
    for _, c in ipairs(LagConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(LagConnections)
end

local _stealthConn = nil
local function stealthTeleport(root, targetCFrame, speed)
    if not root or not targetCFrame then return end
    if _stealthConn then
        pcall(function() _stealthConn:Disconnect() end)
        _stealthConn = nil
    end
    local current = root.CFrame
    local distance = (current.Position - targetCFrame.Position).Magnitude
    local duration = math.max(distance / (speed or 200), 0.05)
    local startTime = tick()
    _stealthConn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent then
            if _stealthConn then _stealthConn:Disconnect() _stealthConn = nil end
            return
        end
        local elapsed = tick() - startTime
        local alpha = math.min(elapsed / duration, 1)
        alpha = 1 - (1 - alpha) * (1 - alpha)
        root.CFrame = current:Lerp(targetCFrame, alpha)
        if alpha >= 1 then
            if _stealthConn then _stealthConn:Disconnect() _stealthConn = nil end
        end
    end)
end

