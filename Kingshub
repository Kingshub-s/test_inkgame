    if ((Toggles.GuardAutoAim and Toggles.GuardAutoAim.Value) or (Toggles.RLGuardAim and Toggles.RLGuardAim.Value)) then
        local closestPlayer = nil
        local closestDist = math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not isGuard(player) then
                local pRoot = getRoot(player)
                if pRoot then
                    local dist = (pRoot.Position - root.Position).Magnitude
                    if dist < closestDist and dist < 200 then
                        closestDist = dist
                        closestPlayer = player
                    end
                end
            end
        end

        if closestPlayer then
            local pRoot = getRoot(closestPlayer)
            local pHead = getHead(closestPlayer)
            local target = pHead and pHead.Position or pRoot.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target)

            if ((Toggles.GuardAutoShoot and Toggles.GuardAutoShoot.Value) or (Toggles.RLGuardShoot and Toggles.RLGuardShoot.Value)) then
                for _, tool in pairs(char:GetChildren()) do
