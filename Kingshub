-- AIMBOT SYSTEM
local AimbotTarget = nil
local _aimbotLastScan = 0
local _aimbotSmoothCF = nil

local function getClosestEnemy(maxDist)
    maxDist = maxDist or 200
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return nil end

    local closest, closestDist = nil, maxDist
    local myPos = myRoot.Position

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isEnemy(player) and not isGuard(player) then
            local root = getRoot(player)
            local hum = getHum(player)
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - myPos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

local function aimAtTarget(target)
    if not target then return end
    local head = getHead(target)
    local root = getRoot(target)
    local aimPart = head or root
    if not aimPart then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local aimPos = aimPart.Position
    local currentCF = cam.CFrame
    local targetCF = CFrame.lookAt(currentCF.Position, aimPos)

    -- smoothness: 1 = slow/smooth, 10 = fast
    local slider = Options.AimbotSmooth and Options.AimbotSmooth.Value or 3
    -- convert to lerp alpha (lower = smoother)
    local alpha = math.clamp(slider / 25, 0.04, 0.35)

    cam.CFrame = currentCF:Lerp(targetCF, alpha)
end

local function runAimbot()
    if not Toggles.Aimbot or not Toggles.Aimbot.Value then
        AimbotTarget = nil
        return
    end

    -- scan target every 0.15s only (reduces lag)
    local now = tick()
    if now - _aimbotLastScan >= 0.15 or not AimbotTarget then
        _aimbotLastScan = now
        local maxDist = Options.AimbotRange and Options.AimbotRange.Value or 200
        local t = getClosestEnemy(maxDist)
        -- keep old target if still valid and close
        if AimbotTarget and AimbotTarget.Parent then
            local oldRoot = getRoot(AimbotTarget)
            local oldHum = getHum(AimbotTarget)
            if oldRoot and oldHum and oldHum.Health > 0 then
                local myRoot = getRoot(LocalPlayer)
                if myRoot then
                    local d = (oldRoot.Position - myRoot.Position).Magnitude
                    if d <= maxDist * 1.15 then
                        -- stick to current target unless new one is much closer
                        if not t or (getRoot(t) and (getRoot(t).Position - myRoot.Position).Magnitude < d * 0.7) then
                            AimbotTarget = t or AimbotTarget
                        end
                    else
                        AimbotTarget = t
                    end
                else
                    AimbotTarget = t
                end
            else
                AimbotTarget = t
            end
        else
            AimbotTarget = t
        end
    end

    if AimbotTarget then
        aimAtTarget(AimbotTarget)
    end
end

local _lightCache, _lightCacheT = nil, 0
local function isGreenLight()
    if tick() - _lightCacheT < 0.4 then
        return _lightCache
    end
    local result = nil
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in pairs(pg:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                local t = (gui.Text or ""):lower()
                if t:find("green light") or t:find("greenlight") or t == "green" or t:find("go!") then
                    result = true
                    break
                end
                if t:find("red light") or t:find("redlight") or t == "red" or t:find("stop!") or t:find("freeze") then
                    result = false
                    break
                end
            end
        end
    end
    -- Prefer FindFirstChild patterns over full GetDescendants
    if result == nil then
        for _, name in ipairs({"Doll", "Younghee", "TrafficLight", "RedLightDoll", "Statue"}) do
            local obj = Workspace:FindFirstChild(name, true)
            if obj then
                if obj:GetAttribute("IsGreen") == true or obj:GetAttribute("GreenLight") == true then
                    result = true
                    break
                end
                if obj:GetAttribute("IsRed") == true or obj:GetAttribute("RedLight") == true then
                    result = false
                    break
                end
            end
        end
    end
    _lightCache = result
    _lightCacheT = tick()
    return result
end

local function autoRedLight()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    -- Teleport to Finish (when green or forced)
    if Toggles.RLTeleportFinish and Toggles.RLTeleportFinish.Value then
        refreshMinigameCache()
        local light = isGreenLight()
        if light == true then -- fail-closed: unknown = no TP
            local best, bestDist = nil, math.huge
            for _, data in pairs(MinigameCache) do
                if data.Type == "Win" then
                    local obj = data.Obj
                    if obj and obj.Parent then
                        local d = (obj.Position - root.Position).Magnitude
                        if d < bestDist and d > 5 then
                            bestDist = d
                            best = obj
                        end
                    end
                end
            end
            -- Also search by name patterns if cache miss
            if not best then
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local n = obj.Name:lower()
                        if n:find("finish") or n:find("goal") or n:find("endzone") or n:find("safezone") or n:find("line") then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < bestDist and d > 5 and d < 500 then
                                bestDist = d
                                best = obj
                            end
                        end
                    end
                end
            end
            if best then
                safeTeleport(root, best.CFrame + Vector3.new(0, 3, 0), 250)
                return
            end
        end
    end

    if not Toggles.AutoRedLight or not Toggles.AutoRedLight.Value then return end

    refreshMinigameCache()
    local light = isGreenLight()

    -- Freeze on red; unknown = do nothing (fail-closed)
    if light == false then
        if Toggles.RLGLAnchorMode and Toggles.RLGLAnchorMode.Value then
            root.Anchored = true
        else
            if hum.WalkSpeed ~= 0 then
                _origWalkSpeed = hum.WalkSpeed
            end
            hum.WalkSpeed = 0
        end
        return
    elseif light ~= true then
        return
    else
        -- Green or unknown: unfreeze and move
        if root.Anchored then root.Anchored = false end
        if hum.WalkSpeed == 0 then
            hum.WalkSpeed = Toggles.Speed and Toggles.Speed.Value and getRunSpeedTarget() or (_origWalkSpeed or 16)
        end
        -- Move toward finish
        for _, data in pairs(MinigameCache) do
            if data.Type == "Win" then
                local obj = data.Obj
                if obj and obj.Parent then
                    local dir = obj.Position - root.Position
                    if dir.Magnitude > 3 then
                        hum:Move(Vector3.new(dir.X, 0, dir.Z).Unit)
                    end
                    break
                end
            end
        end
    end

    if Toggles.RLGLAutoDodge and Toggles.RLGLAutoDodge.Value then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("bullet") or n:find("projectile") or n:find("shot") or n:find("pellet") or n:find("beam") then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < 25 then
                        local bulletVel = obj.AssemblyLinearVelocity
                        if bulletVel and bulletVel.Magnitude > 5 then
                            local dodgeDir = Vector3.new(bulletVel.Z, 0, -bulletVel.X)
                            if dodgeDir.Magnitude > 0.1 then
                                dodgeDir = dodgeDir.Unit * 15
                            else
                                dodgeDir = Vector3.new(math.random(-1,1), 0, math.random(-1,1))
                                if dodgeDir.Magnitude > 0 then dodgeDir = dodgeDir.Unit * 15 end
                            end
                            root.CFrame = root.CFrame + dodgeDir
                        else
                            local dodgeDir = Vector3.new(math.random(-1,1), 0, math.random(-1,1))
                            if dodgeDir.Magnitude > 0 then
                                root.CFrame = root.CFrame + dodgeDir.Unit * 12
                            end
                        end
                    end
                end
            end
        end
    end
end

local function finishDalgona()
    local char = LocalPlayer.Character
    if not char then
        notify("No character")
        return
    end
    local root = char:FindFirstChild("HumanoidRootPart")

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, gui in pairs(pg:GetDescendants()) do
            if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui.Visible then
                local t = (gui.Name .. " " .. tostring(gui.Text or "")):lower()
                if t:find("finish") or t:find("complete") or t:find("done")
                    or t:find("submit") or t:find("success") or t:find("cut")
                    or t:find("hold") or t:find("breath") or t:find("relax") then
                    pcall(function()
                        if firesignal then
                            firesignal(gui.MouseButton1Click)
                            if gui.Activated then firesignal(gui.Activated) end
                        end
                    end)
                end
            end
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if n:find("dalgona") or n:find("cookie") or n:find("needle") or n:find("shape") then
            if obj:IsA("ClickDetector") then
                pcall(function() fireclickdetector(obj) end)
            end
            if obj:IsA("ProximityPrompt") then
                pcall(function()
                    local old = obj.HoldDuration
                    obj.HoldDuration = 0
                    fireproximityprompt(obj)
                    obj.HoldDuration = old
                end)
            end
            if obj:IsA("BasePart") and root and (obj.Position - root.Position).Magnitude < 30 then
                for _, d in pairs(obj:GetDescendants()) do
                    if d:IsA("ClickDetector") then
                        pcall(function() fireclickdetector(d) end)
                    end
                    if d:IsA("ProximityPrompt") then
                        pcall(function() fireproximityprompt(d) end)
                    end
                end
            end
        end
    end

    pcall(function()
        for _, rem in pairs(ReplicatedStorage:GetDescendants()) do
            if rem:IsA("RemoteEvent") then
                local n = rem.Name:lower()
                if n:find("dalgona") or n:find("cookie") or n:find("complete") or n:find("finish") then
                    pcall(function() rem:FireServer() end)
                    pcall(function() rem:FireServer("Complete") end)
                    pcall(function() rem:FireServer(true) end)
                end
            end
        end
    end)

    notify("Finish Dalgona attempted")
end

local function autoGlassBridge()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if Toggles.GBTPEnd and Toggles.GBTPEnd.Value then
        safeTeleport(root, CFrame.new(Vector3.new(-203.9, 520.7, -1534.35)), 300)
        return
    end

    if not Toggles.AutoGlassBridge or not Toggles.AutoGlassBridge.Value then return end

    refreshMinigameCache()
    local safePanels = {}
    for _, data in pairs(MinigameCache) do
        if data.Type == "Glass" then
            local obj = data.Obj
            if obj and obj.Parent and isGlassSafe(obj) then
                table.insert(safePanels, obj)
            end
        end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if (n:find("glass") or n:find("panel") or n:find("tile")) and isGlassSafe(obj) then
                local already = false
                for _, p in pairs(safePanels) do
                    if p == obj then already = true break end
                end
                if not already then table.insert(safePanels, obj) end
            end
        end
    end
    table.sort(safePanels, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)

    if Toggles.GBSkipTech and Toggles.GBSkipTech.Value and #safePanels >= 2 then
        safeTeleport(root, safePanels[math.min(2, #safePanels)].CFrame + Vector3.new(0, 2, 0), 200)
    elseif #safePanels >= 1 then
        local nearest = safePanels[1]
        if (nearest.Position - root.Position).Magnitude < 60 then
            safeTeleport(root, nearest.CFrame + Vector3.new(0, 2, 0), 80)
        end
    end
end

local _lastTOWQTE = 0
local function autoTugOfWar()
    local anyTOW = (Toggles.AutoTugOfWar and Toggles.AutoTugOfWar.Value)
        or (Toggles.TOWAutoPull and Toggles.TOWAutoPull.Value)
    if not anyTOW then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum then return end

    -- Keep slight movement
    if root then
        hum:Move(Vector3.new(0, 0, -0.3))
    end

    -- Improved QTE: look for skill-check style UI and press Space/E at better timing
    if tick() - _lastTOWQTE < 0.12 then return end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local shouldPress = false

    if pg then
        for _, gui in pairs(pg:GetDescendants()) do
            if gui.Visible then
                local name = (gui.Name or ""):lower()
                local text = tostring(gui.Text or ""):lower()
                local full = name .. " " .. text

                -- Detect QTE / skill check / tug UI
                if full:find("qte") or full:find("skill") or full:find("check")
                    or full:find("tug") or full:find("pull") or full:find("space")
                    or full:find("press") or full:find("timing") then
                    shouldPress = true
                end

                -- Also try clicking visible QTE buttons
                if (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui.AbsoluteSize.X > 8 then
                    if full:find("qte") or full:find("pull") or full:find("press") or full:find("space") then
                        pcall(function()
                            if firesignal then
                                firesignal(gui.MouseButton1Click)
                                if gui.Activated then firesignal(gui.Activated) end
                            end
                        end)
                        shouldPress = true
                    end
                end
            end
        end
    end

    -- Always attempt timed presses when Auto is on (fallback spam with slight variation)
    if shouldPress or (Toggles.TOWAutoPull and Toggles.TOWAutoPull.Value) then
        _lastTOWQTE = tick()
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
        -- Small chance extra press for Rhythmical style
        if math.random() < 0.35 then
            task.delay(0.05, function()
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end)
            end)
        end
    end
end

local function isRopeObject(obj)
    if not obj then return false end
    local n = obj.Name:lower()
    if n:find("rope") or n:find("swing") or n:find("jumprope") or n:find("jump_rope") then
        return true
    end
    -- Parent model named rope
    local p = obj.Parent
    if p and (p.Name:lower():find("rope") or p.Name:lower():find("jumprope")) then
        return true
    end
    return false
end

local function blockRope()
        for _, obj in pairs(Workspace:GetDescendants()) do
        if isRopeObject(obj) then
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.Transparency = 1
                    obj.Anchored = true
                    obj.AssemblyLinearVelocity = Vector3.zero
                    obj.AssemblyAngularVelocity = Vector3.zero
                    -- try destroy
                    obj:Destroy()
                elseif obj:IsA("Model") or obj:IsA("Folder") then
                    for _, c in pairs(obj:GetDescendants()) do
                        if c:IsA("BasePart") then
                            c.CanCollide = false
                            c.CanTouch = false
                            c.Transparency = 1
                        end
                    end
                    obj:Destroy()
                elseif obj:IsA("Beam") or obj:IsA("RopeConstraint") or obj:IsA("RodConstraint") then
                    obj.Enabled = false
                    obj:Destroy()
                elseif obj:IsA("MeshPart") then
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.Transparency = 1
                    obj:Destroy()
                end
            end)
        end
    end
    -- Also strip TouchInterest on anything rope-related near player
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("TouchTransmitter") or obj.ClassName == "TouchInterest" then
                local part = obj.Parent
                if part and part:IsA("BasePart") and isRopeObject(part) then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
    end
end

