local function removeESP(player)
    if not ESPObjects[player] then return end
    for _, obj in pairs(ESPObjects[player]) do
        if obj then pcall(function() obj:Remove() end) end
    end
    ESPObjects[player] = nil
end

local function updateESP()
    ESPFrameCount = ESPFrameCount + 1
    local rate = Options.ESPUpdateRate and Options.ESPUpdateRate.Value or 1
    if ESPFrameCount % rate ~= 0 then return end

    local myChar = LocalPlayer.Character
    if not myChar then
        for _, objs in pairs(ESPObjects) do
            for _, obj in pairs(objs) do obj.Visible = false end
        end
        return
    end

    local myRoot = getRoot(LocalPlayer)
    local myPos = myRoot and myRoot.Position or myChar:GetPivot().Position
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

    for player, objs in pairs(ESPObjects) do
        repeat
        if not player or not player.Parent then removeESP(player) break end
        local char = player.Character
        if not char then
            for _, obj in pairs(objs) do obj.Visible = false end
            break
        end

        local hum = getHum(player)
        local root = getRoot(player)
        local head = getHead(player)
        if not hum or hum.Health <= 0 or not root or not head then
            for _, obj in pairs(objs) do obj.Visible = false end
            break
        end

        local dist = (myPos - root.Position).Magnitude
        local maxDist = Options.ESPMaxDistance and Options.ESPMaxDistance.Value or 1000
        if dist > maxDist then
            for _, obj in pairs(objs) do obj.Visible = false end
            break
        end

        local headPos, headOn = worldToScreen(head.Position + Vector3.new(0, 0.5, 0))
        local rootPos, rootOn = worldToScreen(root.Position - Vector3.new(0, 2.5, 0))
        if not headOn or not rootOn then
            for _, obj in pairs(objs) do obj.Visible = false end
            break
        end

        local boxH = math.abs(headPos.Y - rootPos.Y)
        local boxW = boxH * 0.55
        local boxPos = Vector2.new(headPos.X - boxW / 2, headPos.Y)

        local enemy = isEnemy(player)
        local guard = isGuard(player)
        local seeker = isSeeker(player)
        local hider = isHider(player)
        local espColor
        local showESP = true
        local displayName = player.Name

        -- Hide & Seek role ESP (priority)
        if seeker and Toggles.ESPSeekers and Toggles.ESPSeekers.Value then
            espColor = Color3.fromRGB(255, 40, 40) -- Killer/Seeker = Red
            displayName = "[KILLER] " .. player.Name
        elseif hider and Toggles.ESPHiders and Toggles.ESPHiders.Value then
            espColor = Color3.fromRGB(0, 220, 255) -- Hider = Cyan
            displayName = "[HIDER] " .. player.Name
        elseif guard and Toggles.GuardESP and Toggles.GuardESP.Value then
            espColor = Color3.fromRGB(255, 165, 0)
            displayName = "[GUARD] " .. player.Name
        elseif enemy then
            espColor = Color3.fromRGB(255, 60, 60)
        else
            espColor = Color3.fromRGB(60, 255, 60)
        end

        -- Force show box/name when HS role ESP is on for that role
        local forceHS = (seeker and Toggles.ESPSeekers and Toggles.ESPSeekers.Value)
            or (hider and Toggles.ESPHiders and Toggles.ESPHiders.Value)

        if (Toggles.BoxESP and Toggles.BoxESP.Value) or forceHS then
            objs.Box.Size = Vector2.new(boxW, boxH); objs.Box.Position = boxPos
            objs.Box.Color = espColor; objs.Box.Visible = true
            objs.BoxOutline.Size = Vector2.new(boxW, boxH); objs.BoxOutline.Position = boxPos; objs.BoxOutline.Visible = true
        else objs.Box.Visible = false; objs.BoxOutline.Visible = false end

        if (Toggles.NameESP and Toggles.NameESP.Value) or forceHS then
            objs.Name.Text = displayName; objs.Name.Position = Vector2.new(headPos.X, boxPos.Y - 18)
            objs.Name.Color = espColor
            objs.Name.Visible = true
        else objs.Name.Visible = false end

        if Toggles.HealthESP and Toggles.HealthESP.Value then
            local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barH = boxH * hp
            objs.HealthBar.Size = Vector2.new(3, barH)
            objs.HealthBar.Position = Vector2.new(boxPos.X - 8, boxPos.Y + (boxH - barH))
            objs.HealthBar.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0); objs.HealthBar.Visible = true
            objs.HealthBarOutline.Size = Vector2.new(5, boxH); objs.HealthBarOutline.Position = Vector2.new(boxPos.X - 9, boxPos.Y); objs.HealthBarOutline.Visible = true
        else objs.HealthBar.Visible = false; objs.HealthBarOutline.Visible = false end

        if Toggles.DistanceESP and Toggles.DistanceESP.Value then
            objs.Distance.Text = math.floor(dist) .. "m"; objs.Distance.Position = Vector2.new(headPos.X, rootPos.Y + 6); objs.Distance.Visible = true
        else objs.Distance.Visible = false end

        if Toggles.TracerESP and Toggles.TracerESP.Value then
            objs.Tracer.From = screenCenter; objs.Tracer.To = rootPos
            objs.Tracer.Color = espColor; objs.Tracer.Visible = true
            objs.TracerOutline.From = screenCenter; objs.TracerOutline.To = rootPos; objs.TracerOutline.Visible = true
        else objs.Tracer.Visible = false; objs.TracerOutline.Visible = false end
        until true
    end
end


-- GLASS BRIDGE ESP
local GlassESPObjects = {}
local GlassHighlightCache = {}
local GlassESPFrameCount = 0

local function clearGlassHighlights()
    for part, h in pairs(GlassHighlightCache) do
        pcall(function() if h then h:Destroy() end end)
    end
    table.clear(GlassHighlightCache)
end

local function isGlassSafe(obj)
    if not obj or not obj:IsA("BasePart") then return false end

    -- 1. Attributes (old + possible new names)
    for _, a in ipairs({
        "Safe", "IsSafe", "Correct", "Good", "Real", "Solid",
        "Tempered", "IsTempered", "Valid", "CanStand", "Strong"
    }) do
        local v = obj:GetAttribute(a)
        if v == true or v == 1 or tostring(v):lower() == "true" then
            return true
        end
        if v == false or v == 0 or tostring(v):lower() == "false" then
            return false -- explicitly unsafe
        end
    end

    -- 2. Child markers
    if obj:FindFirstChild("Safe") or obj:FindFirstChild("Correct")
        or obj:FindFirstChild("IsSafe") or obj:FindFirstChild("Good")
        or obj:FindFirstChild("Tempered") then
        return true
    end
    if obj:FindFirstChild("Unsafe") or obj:FindFirstChild("Fake")
        or obj:FindFirstChild("Break") or obj:FindFirstChild("Fragile") then
        return false
    end

    -- 3. Parent checks
    local p = obj.Parent
    if p then
        if p:FindFirstChild("Safe") or p:FindFirstChild("Correct") or p:FindFirstChild("Tempered") then
            return true
        end
        local pn = p.Name:lower()
        if pn:find("safe") or pn:find("correct") or pn:find("real") or pn:find("tempered") then
            return true
        end
        if pn:find("unsafe") or pn:find("fake") or pn:find("break") then
            return false
        end
    end

    -- 4. Color heuristics (green-ish = safe, strong red = unsafe)
    local c = obj.Color
    if c.G > 0.65 and c.R < 0.45 and c.B < 0.45 then
        return true
    end
    if c.R > 0.7 and c.G < 0.35 and c.B < 0.35 then
        return false
    end

    -- 5. Material
    if obj.Material == Enum.Material.ForceField or obj.Material == Enum.Material.Neon then
        return true
    end

    -- 6. Transparency / Reflectance (foggy/smudged often more transparent or different)
    -- Unsafe panels often get fog → higher transparency or different reflectance
    if obj.Transparency > 0.35 then
        return false -- likely fogged = unsafe
    end
    if obj.Transparency < 0.05 and obj.Reflectance > 0.15 then
        return true -- clean reflective glass tends to be tempered
    end

    -- 7. Name
    local n = obj.Name:lower()
    if n:find("safe") or n:find("correct") or n:find("real") or n:find("good") or n:find("tempered") then
        return true
    end
    if n:find("unsafe") or n:find("fake") or n:find("break") or n:find("fragile") or n:find("bad") then
        return false
    end

    -- 8. Look for Decals / Textures that indicate fog
    for _, child in pairs(obj:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            local cn = child.Name:lower()
            if cn:find("fog") or cn:find("smudge") or cn:find("crack") or cn:find("break") then
                return false
            end
            if cn:find("safe") or cn:find("clean") then
                return true
            end
        end
    end

    -- Default: unknown (don't mark as safe)
    return false
end

local function isGlassPanel(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    local n = obj.Name:lower()
    if n:find("glass") or n:find("panel") or n:find("tile") or n:find("bridge")
        or n:find("platform") or n:find("step") or n:find("plank") then
        return true
    end
    local s = obj.Size
    -- Typical glass panel size
    if s.Y < 2.5 and s.X > 3.5 and s.Z > 3.5 then
        local p = obj.Parent
        if p then
            local pn = p.Name:lower()
            if pn:find("glass") or pn:find("bridge") or pn:find("panel")
                or pn:find("tiles") or pn:find("platforms") or pn:find("map") then
                return true
            end
        end
        -- Also accept if material looks like glass
        if obj.Material == Enum.Material.Glass or obj.Material == Enum.Material.ForceField
            or obj.Transparency > 0.1 then
            return true
        end
    end
    return false
end

local function updateGlassESP()
    if not Toggles or not Toggles.GlassBridgeESP or not Toggles.GlassBridgeESP.Value then
        for _, obj in pairs(GlassESPObjects) do
            if obj then pcall(function() obj:Remove() end) end
        end
        table.clear(GlassESPObjects)
        clearGlassHighlights()
        return
    end

    GlassESPFrameCount = GlassESPFrameCount + 1
    if GlassESPFrameCount % 25 ~= 0 then return end -- faster update

    for _, obj in pairs(GlassESPObjects) do
        if obj then pcall(function() obj:Remove() end) end
    end
    table.clear(GlassESPObjects)

    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return end
    if type(Drawing) ~= "table" or type(Drawing.new) ~= "function" then return end

    local searchRoot = Workspace
    for _, name in ipairs({"GlassBridge", "Glass", "Panels", "Tiles", "Bridge", "Map", "Game"}) do
        local f = Workspace:FindFirstChild(name, true)
        if f then
            searchRoot = f
            break
        end
    end

    local seen = {}
    local idx = 0

    for _, obj in pairs(searchRoot:GetDescendants()) do
        if isGlassPanel(obj) then
            local dist = (obj.Position - myRoot.Position).Magnitude
            if dist < 130 then
                idx = idx + 1
                if idx > 40 then break end

                local safe = isGlassSafe(obj)
                seen[obj] = true

                -- Green highlight on safe panels
                if safe then
                    if not GlassHighlightCache[obj] then
                        local h = Instance.new("Highlight")
                        h.Name = "KH_GlassSafe"
                        h.FillColor = Color3.fromRGB(0, 255, 80)
                        h.OutlineColor = Color3.fromRGB(0, 200, 60)
                        h.FillTransparency = 0.45
                        h.OutlineTransparency = 0
                        h.Adornee = obj
                        h.Parent = obj
                        GlassHighlightCache[obj] = h
                    end
                else
                    if GlassHighlightCache[obj] then
                        pcall(function() GlassHighlightCache[obj]:Destroy() end)
                        GlassHighlightCache[obj] = nil
                    end
                end

                local screenPos, onScreen = worldToScreen(obj.Position)
                if onScreen then
                    local ok, txt = pcall(function() return Drawing.new("Text") end)
                    if ok and txt then
                        txt.Size = 13
                        txt.Center = true
                        txt.Outline = true
                        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        txt.Font = Drawing.Fonts.UI
                        txt.Position = screenPos
                        if safe then
                            txt.Text = "SAFE"
                            txt.Color = Color3.fromRGB(0, 255, 80)
                        else
                            txt.Text = "UNSAFE"
                            txt.Color = Color3.fromRGB(255, 40, 40)
                        end
                        txt.Visible = true
                        GlassESPObjects[idx] = txt
                    end
                end
            end
        end
    end

    -- cleanup highlights for parts no longer in range
    for part, h in pairs(GlassHighlightCache) do
        if not seen[part] or not part.Parent then
            pcall(function() h:Destroy() end)
            GlassHighlightCache[part] = nil
        end
    end
end

-- MOVEMENT SYSTEM

local SpeedConn, NoClipConn, AntiRagdollConn = nil, nil, nil

local _origWalkSpeed = 16
local function startSpeed()
    if SpeedConn then return end
    SpeedConn = RunService.RenderStepped:Connect(function()
        if not Toggles.Speed or not Toggles.Speed.Value then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.WalkSpeed > 0 and hum.WalkSpeed < 25 and math.abs(hum.WalkSpeed - (Options.SpeedValue and Options.SpeedValue.Value or 18)) > 1 then
            _origWalkSpeed = hum.WalkSpeed
        end
        local speedVal = Options.SpeedValue and Options.SpeedValue.Value or 18
        if math.abs(hum.WalkSpeed - speedVal) > 0.5 then
            hum.WalkSpeed = speedVal
        end
    end)
end

local function stopSpeed()
    if SpeedConn then SpeedConn:Disconnect() SpeedConn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _origWalkSpeed or 16 end
    end
end

local function getRunSpeedTarget()
    return Options.SpeedValue and Options.SpeedValue.Value or 16
end

-- Safer NoClip: only disable collision on Stepped (physics step).
-- Does NOT permanently rewrite character parts (avoids "modified character" kicks).
local function setNoClip(enabled)
    if NoClipConn then
        pcall(function() NoClipConn:Disconnect() end)
        NoClipConn = nil
    end
    if not enabled then return end

    NoClipConn = RunService.Stepped:Connect(function()
        if not Toggles or not Toggles.NoClip or not Toggles.NoClip.Value then return end
        local char = LocalPlayer.Character
        if not char then return end
        -- Only body parts (skip accessories) — less AC noise
        for _, name in ipairs({
            "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso",
            "Left Arm", "Right Arm", "Left Leg", "Right Leg",
            "LeftUpperArm", "LeftLowerArm", "LeftHand",
            "RightUpperArm", "RightLowerArm", "RightHand",
            "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
            "RightUpperLeg", "RightLowerLeg", "RightFoot",
        }) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

local function startAntiRagdoll()
    if AntiRagdollConn then return end
    AntiRagdollConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.PlatformStand then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if hum.Sit then hum.Sit = false end
        if Toggles.Speed and Toggles.Speed.Value then
            local targetSpeed = Options.SpeedValue and Options.SpeedValue.Value or 18
            if hum.WalkSpeed < targetSpeed and hum.WalkSpeed ~= 0 then
                hum.WalkSpeed = targetSpeed
            end
        end
        -- Do NOT Destroy character children here (triggers modified character AC)
        if hum.PlatformStand then
            hum.PlatformStand = false
        end
    end)
end

local function stopAntiRagdoll()
    if AntiRagdollConn then AntiRagdollConn:Disconnect() AntiRagdollConn = nil end
end

local function restoreMovementState()
    setNoClip(false)
    stopSpeed()
    stopAntiRagdoll()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and root.Anchored then root.Anchored = false end
end

local function getFlingTargets(str)
    local found = {}
    local s = (str or ""):lower():gsub("%s+", "")
    if s == "" or s == "me" then
        return found
    end
    if s == "all" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(found, p)
            end
        end
        return found
    end
    if s == "others" then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(found, p)
            end
        end
        return found
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Name:lower():sub(1, #s) == s then
            table.insert(found, p)
        end
    end
    return found
end

local _flingThrust = nil
local _flingConn = nil

local function stopFling()
    if _flingConn then
        pcall(function() _flingConn:Disconnect() end)
        _flingConn = nil
    end
    if _flingThrust then
        pcall(function() _flingThrust:Destroy() end)
        _flingThrust = nil
    end
end

local function flingPlayer(name)
    local targets = getFlingTargets(name)
    if #targets == 0 then
        notify("No target found")
        return
    end

    local target = targets[1]
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local tRoot = getRoot(target)
    local tHum = getHum(target)
    if not tRoot or not tHum or tHum.Health <= 0 then
        notify("Target invalid")
        return
    end

    stopFling()

    local power = Options.FlingPower and Options.FlingPower.Value or 9999
    local thrust = Instance.new("BodyThrust")
    thrust.Force = Vector3.new(power, power, power)
    thrust.Name = "KH_Fling"
    thrust.Parent = root
    _flingThrust = thrust

    local start = tick()
    _flingConn = RunService.Heartbeat:Connect(function()
        if not genv.KH_Runtime or not genv.KH_Runtime.running then
            stopFling()
            return
        end
        if not target.Parent or not tRoot.Parent or tHum.Health <= 0 then
            stopFling()
            return
        end
        if tick() - start > 4 then
            stopFling()
            return
        end
        root.CFrame = tRoot.CFrame
        thrust.Location = tRoot.Position
    end)

    notify("Flinging: " .. target.Name)
end

-- MINIGAME CACHE & DETECTION

local MinigameCache = {}
local CacheTick = 0
local CurrentMinigame = "None"

-- Manual override via Game Selector
local ManualMinigame = nil

local function detectCurrentMinigame()
    -- If manual override is set, use it
    if ManualMinigame and ManualMinigame ~= "Auto-Detect" then
        return ManualMinigame
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
