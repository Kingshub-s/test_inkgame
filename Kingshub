local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    if myTeam and theirTeam then return myTeam ~= theirTeam end
    return true
end

local function isGuard(player)
    if not player then return false end
    local char = getChar(player)
    if not char then return false end
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") then
            if obj.Name:lower():find("guard") or obj.Name:lower():find("uniform") then
                return true
            end
        end
    end
    if player.Team and tostring(player.Team):lower():find("guard") then return true end
    return false
end


local function isSeeker(player)
    if not player then return false end
    if player.Team then
        local tn = tostring(player.Team.Name or player.Team):lower()
        if tn:find("seek") or tn:find("killer") or tn:find("hunter") or tn:find("tagger") then
            return true
        end
        if tn:find("hide") or tn:find("runner") or tn:find("survivor") then
            return false
        end
    end
    local char = getChar(player)
    if not char then return false end
    local role = char:GetAttribute("Role") or char:GetAttribute("Team") or char:GetAttribute("GameRole")
    if role then
        local r = tostring(role):lower()
        if r:find("seek") or r:find("killer") or r:find("hunter") then return true end
        if r:find("hide") or r:find("runner") then return false end
    end
    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            local n = obj.Name:lower()
            if n:find("knife") or n:find("sword") or n:find("bat") or n:find("weapon") or n:find("gun") or n:find("seek") then
                return true
            end
        end
    end
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("StringValue") or obj:IsA("BoolValue") then
            local n = obj.Name:lower()
            if n:find("seek") or n:find("killer") then
                if obj:IsA("BoolValue") and obj.Value then return true end
                if obj:IsA("StringValue") then
                    local v = tostring(obj.Value):lower()
                    if v:find("seek") or v:find("killer") then return true end
                end
            end
        end
    end
    return false
end

local function isHider(player)
    if not player or player == LocalPlayer then return false end
    if isSeeker(player) then return false end
    if isGuard(player) then return false end
    if player.Team then
        local tn = tostring(player.Team.Name or player.Team):lower()
        if tn:find("hide") or tn:find("runner") or tn:find("survivor") then
            return true
        end
        if tn:find("seek") or tn:find("killer") then
            return false
        end
    end
    local char = getChar(player)
    if char then
        local role = char:GetAttribute("Role") or char:GetAttribute("Team") or char:GetAttribute("GameRole")
        if role then
            local r = tostring(role):lower()
            if r:find("hide") or r:find("runner") or r:find("survivor") then return true end
            if r:find("seek") or r:find("killer") then return false end
        end
    end
    -- If ESP Hiders is on and player is not seeker, treat as hider during active mode
    if ((Toggles.ESPHiders and Toggles.ESPHiders.Value) or (Toggles.HS_ESPHiders and Toggles.HS_ESPHiders.Value)) and not isSeeker(player) then
        -- soft detection: anyone who is enemy and not seeker can show as hider
        return isEnemy(player)
    end
    return false
end

local function removeInjury()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum then return end
    hum.PlatformStand = false
    hum.Sit = false
    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)
    if root then root.Anchored = false end
    for _, name in ipairs({"Ragdoll", "StopLerpTrue", "Injury", "Stun", "Knocked"}) do
        local obj = char:FindFirstChild(name)
        if obj then pcall(function() obj:Destroy() end) end
    end
    LagBypass.CleanCharacter(char)
end


