                local dist = (obj.Position - root.Position).Magnitude
                if dist < 20 then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    break
                end
            end
        end
    end
    hum:Move(root.CFrame.LookVector)

    if Toggles.JRBlockHelper and Toggles.JRBlockHelper.Value then
        local blockPos = findObject({"block", "defense", "defensive"}, Workspace)
        if blockPos and (blockPos.Position - root.Position).Magnitude < 30 then
