-- MAIN LOOP


local LoopCounter = 0

-- If workspace is flooding with new instances (queue/map load), pause heavy scans
do
    local recentAdds = 0
    Workspace.DescendantAdded:Connect(function()
        recentAdds = recentAdds + 1
        if recentAdds > 80 then
            pauseHeavy(2.5)
            recentAdds = 0
        end
    end)
    task.spawn(function()
        while genv.KH_Runtime and (type(genv.KH_Runtime) == "table" and genv.KH_Runtime.running or genv.KH_Runtime == true) do
            task.wait(1)
            recentAdds = 0
        end
    end)
end

MainLoopConn = RunService.Heartbeat:Connect(function()
    if not genv.KH_Runtime or not genv.KH_Runtime.running then return end
    LoopCounter = LoopCounter + 1

    if isHeavyPaused() or not LocalPlayer.Character then
        if LoopCounter % 180 == 0 then
            Camera = Workspace.CurrentCamera
        end
        return
    end

    local playerCount = #Players:GetPlayers()
    if playerCount > 60 and LoopCounter % 3 ~= 0 then
        return
    end

    if LoopCounter % 180 == 0 then
        Camera = Workspace.CurrentCamera
    end

    if LoopCounter % 45 == 0 and espWanted() then
        pcall(updateESP)
        if Toggles.GlassBridgeESP and Toggles.GlassBridgeESP.Value then
            pcall(updateGlassESP)
        end
    end

    -- Aimbot every heartbeat (smooth)
    if Toggles.Aimbot and Toggles.Aimbot.Value then
        pcall(runAimbot)
    end

    -- Combat / Fling less often
    if LoopCounter % 12 == 0 then
        if Toggles.KillAura and Toggles.KillAura.Value then
            pcall(killAura)
        end
        if Toggles.FlingLoop and Toggles.FlingLoop.Value then
            local name = Options.FlingTarget and Options.FlingTarget.Value or ""
            if name ~= "" then
                pcall(flingPlayer, name)
            end
        end
    end

    if LoopCounter % 300 == 0 then
        local T = Toggles
        if T.AutoFarm and T.AutoFarm.Value then pcall(autoFarm) end
        if T.AutoCollectDrops and T.AutoCollectDrops.Value then pcall(autoCollectDrops) end

        if (T.AutoTugOfWar and T.AutoTugOfWar.Value) or (T.TOWAutoPull and T.TOWAutoPull.Value) then
            pcall(autoTugOfWar)
        end
        if (T.AutoJumpRope and T.AutoJumpRope.Value) or (T.JRTPEnd and T.JRTPEnd.Value) or (T.JRDeleteRope and T.JRDeleteRope.Value) or (T.JRBlockHelper and T.JRBlockHelper.Value) then
            pcall(autoJumpRope)
        end
        if (T.AutoHideSeek and T.AutoHideSeek.Value) or (T.HSAutoHide and T.HSAutoHide.Value) or (T.HSKillHiders and T.HSKillHiders.Value) then
            pcall(autoHideSeek)
        end
        if (T.AutoMingle and T.AutoMingle.Value) or (T.MingleAutoQTE and T.MingleAutoQTE.Value)
            or (T.MingleChoke and T.MingleChoke.Value) or (T.MingleGrabChoke and T.MingleGrabChoke.Value)
            or (T.MingleChokeTP and T.MingleChokeTP.Value) or (T.MingleAutoSurvive and T.MingleAutoSurvive.Value) then
            pcall(autoMingle)
        end
        if (T.AutoSquidGame and T.AutoSquidGame.Value) or (T.SGAimbot and T.SGAimbot.Value) or (T.SGAutoFight and T.SGAutoFight.Value) then
            pcall(autoSquidGame)
        end
        if (T.AutoSkySquid and T.AutoSkySquid.Value) or (T.SSGAutoClimb and T.SSGAutoClimb.Value) then
            pcall(autoSkySquid)
        end

        if (T.AutoFinalDinner and T.AutoFinalDinner.Value) or (T.FDAutoThrow and T.FDAutoThrow.Value) then
            pcall(autoFinalDinner)
        end
        if (T.AutoPentathlon and T.AutoPentathlon.Value) or (T.PentStacker and T.PentStacker.Value) then
            pcall(autoPentathlon)
        end
        if (T.AutoGuardMode and T.AutoGuardMode.Value) or (T.RLGuardMode and T.RLGuardMode.Value) then
            pcall(autoGuardMode)
        end
        if T.AutoAbility and T.AutoAbility.Value then pcall(autoAbility) end
        if T.AutoEquipAbility and T.AutoEquipAbility.Value then pcall(autoEquipAbility) end
        if T.AutoAllAbilities and T.AutoAllAbilities.Value then pcall(autoAllAbilities) end
        if T.AutoHeal and T.AutoHeal.Value then pcall(autoHeal) end
        if T.InfiniteStamina and T.InfiniteStamina.Value then pcall(infiniteStamina) end
    end

    if LoopCounter > 1500 then LoopCounter = 0 end
end)

