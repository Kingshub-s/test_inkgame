local function autoFarm()
    if not Toggles.AutoFarm or not Toggles.AutoFarm.Value then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    refreshMinigameCache()
    for _, data in pairs(MinigameCache) do
        if data.Type == "Coin" or data.Type == "Gem" or data.Type == "Collectible" then
            local obj = data.Obj
            if obj and obj.Parent then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < 80 and dist > 5 then
                    safeTeleport(root, obj.CFrame, 200)
                    task.wait(0.15)
                elseif dist <= 5 then
                    root.CFrame = obj.CFrame
                end
            end
        end
    end
end

local function autoCollectDrops()
    if not Toggles.AutoCollectDrops or not Toggles.AutoCollectDrops.Value then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    refreshWSCache()
    for _, obj in pairs(WSCache.Parts) do
        if obj and obj.Parent then
            local name = obj.Name:lower()
            if name:find("drop") or name:find("pickup") or name:find("banana") or name:find("bandage") or name:find("lunchbox") then
                if obj:FindFirstChild("TouchInterest") or obj:FindFirstChildOfClass("TouchTransmitter") then
                    local dist = (obj.Position - root.Position).Magnitude
                    if dist < 20 then
                        pcall(function()
                            firetouchinterest(root, obj, 0)
                            firetouchinterest(root, obj, 1)
                        end)
                    end
                end
            end
        end
    end
end

local function autoHeal()
    if not Toggles.AutoHeal or not Toggles.AutoHeal.Value then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.Health / hum.MaxHealth < 0.5 then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, tool in pairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and (tool.Name:lower():find("bandage") or tool.Name:lower():find("heal") or tool.Name:lower():find("med") or tool.Name:lower():find("doctor")) then
                    tool.Parent = char
                    task.wait(0.1)
                    if tool.Parent == char then tool:Activate() end
                    return
                end
            end
        end
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("bandage") or tool.Name:lower():find("heal") or tool.Name:lower():find("med")) then
                tool:Activate()
                return
            end
        end
    end
end

local function infiniteStamina()
    if not Toggles.InfiniteStamina or not Toggles.InfiniteStamina.Value then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            if obj.Name:lower():find("stamina") or obj.Name:lower():find("energy") or obj.Name:lower():find("blood") then
                obj.Value = math.min(obj.Value + 2, 100)
            end
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum:GetState() == Enum.HumanoidStateType.Physics then
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

local function autoAbility()
    if not Toggles.AutoAbility or not Toggles.AutoAbility.Value then return end
    local char = LocalPlayer.Character
    if not char then return end

    local selected = Options.SelectedAbility and Options.SelectedAbility.Value or "Ultra Instinct"
    local selectedLower = selected:lower()

    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower():find(selectedLower) then
            tool:Activate(); return
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find(selectedLower) then
                tool.Parent = char
                task.wait(0.1)
                if tool.Parent == char then tool:Activate() end
                return
            end
        end
    end
end

local function autoEquipAbility()
    if not Toggles.AutoEquipAbility or not Toggles.AutoEquipAbility.Value then return end
    local char = LocalPlayer.Character
    if not char then return end
    local selected = Options.SelectedAbility and Options.SelectedAbility.Value or "Ultra Instinct"
    local selectedLower = selected:lower()

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end

    local hasEquipped = false
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(selectedLower) then hasEquipped = true; break end
    end
    if not hasEquipped then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower():find(selectedLower) then
                tool.Parent = char; break
            end
        end
    end
end

