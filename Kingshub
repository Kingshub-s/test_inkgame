function Library:Validate(Table, Template)
    if typeof(Table) ~= "table" then
        return Template
    end

    for k, v in pairs(Template) do
        repeat
        if typeof(k) == "number" then
            break
        end

        if typeof(v) == "table" then
            Table[k] = Library:Validate(Table[k], v)
        elseif Table[k] == nil then
            Table[k] = v
        end
        until true
    end

    return Table
end

