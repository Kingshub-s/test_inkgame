local function autoMingle()
    local anyMingle = (Toggles.AutoMingle and Toggles.AutoMingle.Value)
        or (Toggles.MingleAutoQTE and Toggles.MingleAutoQTE.Value)
        or (Toggles.MingleChoke and Toggles.MingleChoke.Value)
        or (Toggles.MingleGrabChoke and Toggles.MingleGrabChoke.Value)
        or (Toggles.MingleChokeTP and Toggles.MingleChokeTP.Value)
        or (Toggles.MingleAutoSurvive and Toggles.MingleAutoSurvive.Value)
        or (Toggles.MingleUnstuck and Toggles.MingleUnstuck.Value)
    if not anyMingle then
        MingleLastPos = nil
        MingleStuckTicks = 0
        return
    end
    local doRooms = Toggles.AutoMingle and Toggles.AutoMingle.Value

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    local pos = root.Position
    local vel = root.AssemblyLinearVelocity.Magnitude
    if MingleLastPos then
        local moved = (pos - MingleLastPos).Magnitude
        if moved < 1.2 and vel < 2 then
            MingleStuckTicks = MingleStuckTicks + 1
        else
            MingleStuckTicks = 0
        end
    end
    MingleLastPos = pos

    if MingleStuckTicks >= 3 then
        if Toggles.MingleUnstuck and Toggles.MingleUnstuck.Value then
            mingleUnstuck(root, hum)
            MingleStuckTicks = 0
        end
    end

    local need = getMingleNumber()
    if need then MingleTargetNumber = need end
    need = MingleTargetNumber

    local rooms = doRooms and findMingleRooms(root) or {}

    local best = nil
    if doRooms and need and #rooms > 0 then
        for _, room in ipairs(rooms) do
            if room.Count == need - 1 or room.Count == need then
                best = room
                break
            end
        end
        if not best then
            for _, room in ipairs(rooms) do
                if room.Count < need then
                    best = room
                    break
                end
            end
        end
    end
    if not best and #rooms > 0 then
        best = rooms[1]
    end

    if best then
        enterMingleDoor(best, root)
        if need and best.Count > need then
            if (Toggles.MingleChoke and Toggles.MingleChoke.Value)
                or (Toggles.MingleAutoQTE and Toggles.MingleAutoQTE.Value) then
                task.spawn(doPowerHoldQTE)
            end
            if (Toggles.MingleGrabChoke and Toggles.MingleGrabChoke.Value)
                or (Toggles.MingleChokeTP and Toggles.MingleChokeTP.Value) then
                task.spawn(function() mingleGrabChokeTP(root) end)
            end
        end
    end

    -- Standalone Auto QTE (always spam when QTE UI up)
    if Toggles.MingleAutoQTE and Toggles.MingleAutoQTE.Value then
        task.spawn(doPowerHoldQTE)
    end

    -- Grab / Choke nearby players (RINGTA style)
    if (Toggles.MingleGrabChoke and Toggles.MingleGrabChoke.Value)
        or (Toggles.MingleChoke and Toggles.MingleChoke.Value)
        or (Toggles.MingleChokeTP and Toggles.MingleChokeTP.Value) then
        task.spawn(function() mingleGrabChokeTP(root) end)
    end

    if Toggles.MingleAutoSurvive and Toggles.MingleAutoSurvive.Value then
        if #rooms == 0 then
            local outward = Vector3.new(root.Position.X, 0, root.Position.Z)
            if outward.Magnitude < 20 then
                if outward.Magnitude < 0.1 then outward = Vector3.new(1, 0, 0) end
                outward = outward.Unit * 35 + Vector3.new(0, root.Position.Y, 0)
                safeTeleport(root, CFrame.new(outward), 120)
            end
        end
    end
end

